# ── Backend ────────────────────────────────────────────────────────────────
# API_PORT (not PORT) is the port the API binds to. Never use PORT here:
# VPS panels/PaaS runtimes inject PORT for their own proxy and would move the
# API off the port nginx proxies to.
NODE_ENV=production
API_PORT=8080

# Absolute or cwd-relative path to the SQLite file. Leave unset to use the
# built-in default: backend/data/simplify.db (or /app/data/simplify.db in Docker).
# SIMPLIFY_DB_PATH=/app/data/simplify.db

# 1 = log every request (noisy), 0 = only non-GET requests
LOG_REQUESTS=0

# ── AI chat (alternative to backend/ai-config.json — never commit real keys) ─
AI_API_KEY=
AI_PROVIDER=
AI_MODEL=
OPENAI_API_KEY=
DEBUG_AI=0
