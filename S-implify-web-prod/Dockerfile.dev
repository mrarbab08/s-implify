FROM node:22-alpine

WORKDIR /app

# Install dependencies first for better layer caching.
COPY package*.json ./
RUN npm ci --legacy-peer-deps

# Copy project files.
COPY . .

EXPOSE 4200

# Run Angular dev server in container-friendly mode.
CMD ["npx", "ng", "serve", "--host", "0.0.0.0", "--port", "4200", "--poll", "2000"]
